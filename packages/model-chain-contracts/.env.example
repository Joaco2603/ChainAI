# Environment variables for Avalanche deployment
# NEVER commit this file with real values!

# Your private key for deployment (without 0x prefix)
# Get testnet AVAX from: https://faucet.avax.network/
PRIVATE_KEY=your_private_key_here

# Optional: Snowtrace API key for contract verification
SNOWTRACE_API_KEY=your_api_key_here

# Optional: Enable gas reporting
REPORT_GAS=false
