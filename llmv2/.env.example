# ============================================
# Variables de Entorno - Gemma 2B API
# ============================================
# Copia este archivo a .env y configura tus valores

# ============== REQUERIDO ==============
# Token de HuggingFace para descargar Gemma 2B
# Obtén tu token en: https://huggingface.co/settings/tokens
# Debes aceptar los términos en: https://huggingface.co/google/gemma-2b
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ============== CONFIGURACIÓN DEL MODELO ==============
# Ruta donde se guardan/cargan los pesos del modelo
MODEL_PATH=./model_weights

# ============== CONFIGURACIÓN DEL SERVIDOR ==============
# Puerto donde se ejecuta la API
PORT=8000

# Host (0.0.0.0 para acceso externo, localhost solo local)
HOST=0.0.0.0

# ============== PARÁMETROS DE GENERACIÓN (Opcionales) ==============
# Estos son valores por defecto, se pueden sobrescribir en cada request

# Longitud máxima de tokens a generar
DEFAULT_MAX_LENGTH=100

# Temperatura para sampling (0.1-2.0)
# Mayor = más creativo, Menor = más determinístico
DEFAULT_TEMPERATURE=0.7

# Nucleus sampling (0.0-1.0)
DEFAULT_TOP_P=0.9

# Top-K sampling
DEFAULT_TOP_K=50

# ============== DOCKER ==============
# Variables adicionales para Docker (opcional)
# DOCKER_BUILDKIT=1
